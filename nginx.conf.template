events {}

http {
  # Use Railway's DNS resolver (dynamically detected from /etc/resolv.conf)
  resolver ${DNS_RESOLVER} valid=10s;
  resolver_timeout 5s;

  proxy_connect_timeout 60s;
  proxy_send_timeout 60s;
  proxy_read_timeout 60s;

  server {
    listen 0.0.0.0:${PORT};
    server_name _;

    # Set variables for dynamic DNS resolution
    set $kratos_host ${KRATOS_INTERNAL};
    set $keto_host ${KETO_INTERNAL};
    set $hydra_host ${HYDRA_INTERNAL};
    set $talos_host ${TALOS_INTERNAL};
    set $ui_host ${UI_INTERNAL};
    set $ui_port ${UI_PORT};
    set $oathkeeper_host ${OATHKEEPER_INTERNAL};

    # --- SimpleLogin OAuth Callback (must come before /.ory/) ---
    location ^~ /auth/callback/simplelogin {
      proxy_pass http://$ui_host:$ui_port;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection 'upgrade';
      proxy_cache_bypass $http_upgrade;
      proxy_redirect ~^http://[^/]+/(.*)$ https://$host/$1;
      proxy_redirect ~^https://[^/]+/(.*)$ https://$host/$1;
    }

    # --- Auth routes (login, registration, profile completion, etc.) ---
    location ^~ /auth/ {
      proxy_pass http://$ui_host:$ui_port;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection 'upgrade';
      proxy_cache_bypass $http_upgrade;
      proxy_redirect ~^http://[^/]+/(.*)$ https://$host/$1;
      proxy_redirect ~^https://[^/]+/(.*)$ https://$host/$1;
    }

    # --- OAuth2 API routes (login, logout, etc.) ---
    # Rewrite all Location headers to https://$host so the browser always returns to
    # the gateway domain over HTTPS. Hydra's CSRF session cookie is set on the gateway
    # domain (MAS uses ${GATEWAY_URL}/oauth2/auth as the authorization endpoint), so
    # the consent_verifier and login_verifier redirects must come back through here.
    location ^~ /api/oauth2/ {
      proxy_pass http://$ui_host:$ui_port;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection 'upgrade';
      proxy_cache_bypass $http_upgrade;
      proxy_redirect ~^http://[^/]+/(.*)$ https://$host/$1;
      proxy_redirect ~^https://[^/]+/(.*)$ https://$host/$1;
    }

    # --- OAuth2 /login shortcut (Hydra redirects here) ---
    location ^~ /login {
      # Rewrite /login?... to /api/oauth2/login?... internally
      rewrite ^/login(.*)$ /api/oauth2/login$1 break;
      proxy_pass http://$ui_host:$ui_port;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection 'upgrade';
      proxy_cache_bypass $http_upgrade;
      proxy_redirect ~^http://[^/]+/(.*)$ https://$host/$1;
      proxy_redirect ~^https://[^/]+/(.*)$ https://$host/$1;
    }

    # --- CRITICAL: Ory SDK Endpoints (/.ory/*) ---
    location ^~ /.ory/ {
      rewrite ^/.ory/(.*)$ /$1 break;
      proxy_pass http://$kratos_host:4433;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      # Only rewrite API redirects, not UI redirects (which go to /auth/*)
      proxy_redirect ~^https?://[^/]+/self-service/(.*)$ https://$host/.ory/self-service/$1;
      proxy_redirect ~^https?://[^/]+/sessions/(.*)$ https://$host/.ory/sessions/$1;
      # Let other redirects pass through unchanged (e.g., /auth/* UI pages)
    }

    # --- Hydra Authorization Endpoint ---
    # Inject prompt=login so Hydra always issues a fresh login_challenge instead of
    # silently reusing a remembered session. Skip injection when login_verifier or
    # consent_verifier is present — those are Hydra's internal redirects after
    # challenge acceptance and must not be modified (adding prompt=login causes
    # Hydra to return request_forbidden).
    location = /oauth2/auth {
      set $add_prompt "";
      if ($arg_prompt = "") {
        set $add_prompt "1";
      }
      if ($arg_login_verifier != "") {
        set $add_prompt "";
      }
      if ($arg_consent_verifier != "") {
        set $add_prompt "";
      }
      set $args_with_prompt $args;
      if ($add_prompt = "1") {
        set $args_with_prompt "$args&prompt=login";
      }
      proxy_pass http://$hydra_host:4444/oauth2/auth?$args_with_prompt;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_http_version 1.1;
      proxy_set_header Cookie $http_cookie;
      proxy_redirect off;
    }

    # --- Hydra OIDC Discovery (serves under gateway domain as issuer) ---
    location ^~ /.well-known/ {
      proxy_pass http://$hydra_host:4444;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_redirect off;
    }

    # --- Hydra Userinfo Endpoint ---
    location = /userinfo {
      proxy_pass http://$hydra_host:4444;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header Authorization $http_authorization;
      proxy_redirect off;
    }

    # --- Hydra Public API (OAuth2/OIDC Endpoints) ---
    location ^~ /oauth2/ {
      proxy_pass http://$hydra_host:4444;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_http_version 1.1;
      proxy_set_header Cookie $http_cookie;
      proxy_redirect off;
    }

    # --- Talos API (API keys) ---
    location ^~ /talos/health/ {
      rewrite ^/talos/health/(.*)$ /health/$1 break;
      proxy_pass http://$talos_host:4422;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_redirect ~^http://[^/]+/(.*)$ https://$host/$1;
      proxy_redirect ~^https://[^/]+/(.*)$ https://$host/$1;
    }

    location ^~ /talos/ {
      rewrite ^/talos/(.*)$ /$1 break;
      proxy_pass http://$talos_host:8080;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_redirect ~^http://[^/]+/(.*)$ https://$host/$1;
      proxy_redirect ~^https://[^/]+/(.*)$ https://$host/$1;
    }

    # --- Kratos Admin API (Direct Access - separate path) ---
    location ~ ^/kratos-admin/(identities|sessions|recovery|verification|courier) {
      rewrite ^/kratos-admin/(.*)$ /admin/$1 break;
      proxy_pass http://$kratos_host:4434;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_redirect ~^http://[^/]+/(.*)$ https://$host/$1;
      proxy_redirect ~^https://[^/]+/(.*)$ https://$host/$1;
    }

    # --- Keto Admin API (Write operations) ---
    location ^~ /admin/relation-tuples {
      rewrite ^/admin/relation-tuples(.*)$ /admin/relation-tuples$1 break;
      proxy_pass http://$keto_host:4467;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_redirect ~^http://[^/]+/(.*)$ https://$host/$1;
      proxy_redirect ~^https://[^/]+/(.*)$ https://$host/$1;
    }

    # --- Kratos Public Endpoints ---
    location ^~ /self-service/ {
      rewrite ^/self-service/(.*)$ /self-service/$1 break;
      proxy_pass http://$kratos_host:4433;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_redirect ~^http://[^/]+/(.*)$ https://$host/$1;
      proxy_redirect ~^https://[^/]+/(.*)$ https://$host/$1;
    }

    location ^~ /sessions/ {
      rewrite ^/sessions/(.*)$ /sessions/$1 break;
      proxy_pass http://$kratos_host:4433;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_redirect ~^http://[^/]+/(.*)$ https://$host/$1;
      proxy_redirect ~^https://[^/]+/(.*)$ https://$host/$1;
    }

    location ^~ /health/ {
      rewrite ^/health/(.*)$ /health/$1 break;
      proxy_pass http://$kratos_host:4433;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_redirect ~^http://[^/]+/(.*)$ https://$host/$1;
      proxy_redirect ~^https://[^/]+/(.*)$ https://$host/$1;
    }

    # --- Keto Read API (permission checks, queries) ---
    location ^~ /check {
      rewrite ^/check(.*)$ /check$1 break;
      proxy_pass http://$keto_host:4466;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_redirect ~^http://[^/]+/(.*)$ https://$host/$1;
      proxy_redirect ~^https://[^/]+/(.*)$ https://$host/$1;
    }

    location ^~ /expand {
      rewrite ^/expand(.*)$ /expand$1 break;
      proxy_pass http://$keto_host:4466;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_redirect ~^http://[^/]+/(.*)$ https://$host/$1;
      proxy_redirect ~^https://[^/]+/(.*)$ https://$host/$1;
    }

    # --- Keto Permission Check (POST but on read API) ---
    location ^~ /relation-tuples/check {
      rewrite ^/relation-tuples/check(.*)$ /relation-tuples/check$1 break;
      proxy_pass http://$keto_host:4466;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_redirect ~^http://[^/]+/(.*)$ https://$host/$1;
      proxy_redirect ~^https://[^/]+/(.*)$ https://$host/$1;
    }

    # --- Keto Relation Tuples (read GET, write POST/PUT/PATCH/DELETE) ---
    location ^~ /relation-tuples {
      # Route based on method: GET/HEAD->read (4466), others->write (4467)
      set $keto_port 4467;
      if ($request_method = GET) {
        set $keto_port 4466;
      }
      if ($request_method = HEAD) {
        set $keto_port 4466;
      }
      
      rewrite ^/relation-tuples(.*)$ /relation-tuples$1 break;
      proxy_pass http://$keto_host:$keto_port;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_redirect ~^http://[^/]+/(.*)$ https://$host/$1;
      proxy_redirect ~^https://[^/]+/(.*)$ https://$host/$1;
    }

    # --- Protected Application API Routes (via Oathkeeper) ---
    # Oathkeeper validates the Kratos session cookie or Hydra bearer token,
    # optionally checks Keto permissions, then proxies to the UI upstream.
    # Rules in oathkeeper/rules.json determine per-path auth requirements:
    #   /api/auth/*   → anonymous (public: Kratos webhooks, OAuth callbacks)
    #   /api/admin/*  → authenticated + Keto GlobalRole:admin check
    #   /api/*        → authenticated (cookie session or bearer token)
    location ^~ /api/ {
      proxy_pass http://$oathkeeper_host:4455;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_redirect ~^http://[^/]+/(.*)$ https://$host/$1;
      proxy_redirect ~^https://[^/]+/(.*)$ https://$host/$1;
    }

    # --- Next.js UI (handles /admin/*, pages, etc.) ---
    # This must come LAST so it catches all remaining routes
    location / {
      proxy_pass http://$ui_host:$ui_port;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection 'upgrade';
      proxy_cache_bypass $http_upgrade;
      proxy_redirect ~^http://[^/]+/(.*)$ https://$host/$1;
      proxy_redirect ~^https://[^/]+/(.*)$ https://$host/$1;
    }
  }
}